    <dimen name="vertical_margin">16dp</dimen>
    <dimen name="vertical_small_margin">10dp</dimen>
    <dimen name="vertical_large_margin">24dp</dimen>
    <dimen name="large_text">18sp</dimen>
    <dimen name="normal_text">16sp</dimen>
    <dimen name="small_text">14sp</dimen>
</resources>
